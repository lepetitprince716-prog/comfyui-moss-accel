#!/bin/sh
# Every test. The ComfyUI tests run when COMFYUI_PATH names a ComfyUI checkout and MOSS_ACCEL_PYTHON
# (default python3) can import its requirements; otherwise they are skipped and say why. With CI=true a skip
# is a failure: CI prepares both through ci/setup.
set -eu
cd "$(dirname "$0")"
exec "${MOSS_ACCEL_PYTHON:-python3}" -m unittest discover -s tests -v
